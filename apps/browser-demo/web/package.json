    "./exact-query": {
      "types": "./exact-query.d.ts",
      "import": "./exact-query.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./sdk.js",
  "types": "./sdk.d.ts",
  "files": [
    "camera-policy.js",
    "exact-query.d.ts",
    "exact-query.js",
    "module-loader.js",
    "pkg/browser_demo.d.ts",
    "pkg/browser_demo.js",
    "pkg/browser_demo_bg.wasm",
    "pkg/browser_demo_bg.wasm.d.ts",
    "range-response.js",
    "sdk.d.ts",
    "sdk.js",
    "stream-ordinals.js",
    "stream-worker.js",
    "streaming-protocol.js",
    "viewer-api.d.ts",
    "viewer-api.js",
    "viewer-input.d.ts",
    "viewer-input.js",
    "wasm-loader.js",
    "worker-operation.js",
    "worker-protocol.js"
  ],
  "engines": {
    "node": ">=20"
  }
