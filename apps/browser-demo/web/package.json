{
  "name": "@punctra/viewer",
  "version": "0.18.0-alpha.1",
  "description": "Framework-neutral Punctra WebGPU point-cloud viewer SDK.",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xxibcill/punctra.git",
    "directory": "apps/browser-demo/web"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./sdk.d.ts",
